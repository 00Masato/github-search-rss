        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/25009929?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">This is my best guess at what this book is, but I could be wrong, since this does not seem to be stated anywhere...</p>",
            "url": "https://github.com/rust-lang/rfcs/pull/3767",
            "title": "Book should say what it is about",
            "date_modified": "2025-03-14T10:47:36.000Z",
            "date_published": "2025-01-31T13:23:38.000Z",
            "author": {
                "name": "hkBst",
