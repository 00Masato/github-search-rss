            "author": {
                "name": "Phosphorus-M",
                "url": "https://github.com/Phosphorus-M"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/3161395?u=ecb2aa155dbb36751ff120968e29ac87f076ad1a&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">About as simple as it gets.</p>\n<p dir=\"auto\"><a href=\"https://github.com/jhpratt/rfcs/blob/cfg-logical-ops/text/0000-cfg-logical-ops.md\">Rendered</a></p>",
            "url": "https://github.com/rust-lang/rfcs/pull/3796",
            "title": "Allow `&&`, `||`, and `!` in `cfg`",
            "date_modified": "2025-04-25T02:28:24.000Z",
            "date_published": "2025-03-30T22:48:29.000Z",
            "author": {
                "name": "jhpratt",
