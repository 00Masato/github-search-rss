            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/1830974?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Zulip: <a href=\"https://rust-lang.zulipchat.com/#narrow/channel/131828-t-compiler/topic/Mitigation.20enforcement.20.28.60-C.20allow-partial-mitigations.60.29/with/539293124\" rel=\"nofollow\">https://rust-lang.zulipchat.com/#narrow/channel/131828-t-compiler/topic/Mitigation.20enforcement.20.28.60-C.20allow-partial-mitigations.60.29/with/539293124</a></p>\n<p dir=\"auto\"><a href=\"https://github.com/arielb1/rfcs/blob/track-mitigations/text/3855-mitigation-enforcement.md\">Rendered</a></p>",
            "url": "https://github.com/rust-lang/rfcs/pull/3855",
