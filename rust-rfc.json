        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/19915050?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\"><a href=\"https://github.com/lolbinarycat/rust-rfcs/blob/doc-consts/text/0000-doc-consts.md\">Rendered</a></p>",
